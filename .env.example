# PostgreSQL connection string. Locally, point this at a local Postgres,
# or a free Render/Neon/Supabase instance. On Render, attach a Postgres
# database to this web service and Render injects DATABASE_URL for you.
DATABASE_URL=postgres://user:password@localhost:5432/esl_grammar

# Shared password teachers enter to unlock the dashboard. Set your own
# value here and in the Render dashboard's environment variables.
TEACHER_PASSWORD=change-me

# Optional — defaults to 3001 locally; Render sets this automatically.
PORT=3001

# When the assignment closes. ISO 8601 with an explicit UTC offset so it's
# unambiguous regardless of server timezone. Defaults to Sunday, Sept 20th
# 2026, end of day in Algeria (UTC+1) if left unset — see server/config.js.
SUBMISSION_DEADLINE=2026-09-20T23:59:00+01:00
